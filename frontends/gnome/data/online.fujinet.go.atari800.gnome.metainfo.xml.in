<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.atari800.gnome</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go Atari 800 (GNOME)</name>
  <summary>The Atari 8-bit computers with a built-in FujiNet</summary>
  <description>
    <p>
      The Atari 400, 800, XL and XE computers with a FujiNet plugged into the
      SIO port: browse network hosts from FujiNet's CONFIG program, boot disks
      over the network, and run network programs, all in one application.
    </p>
    <p>
      The emulator is atari800. Every model from the 400 to the XEGS and the
      1450XLD is there, with the 80-column cards (XEP80, Austin Franklin,
      Bit 3, Proto80), the parallel-bus devices, the NTSC filter and PAL
      blending. FujiNet runs inside the application and talks to the Atari
      over NetSIO.
    </p>
    <p>
      No ROMs are needed: AltirraOS and Altirra BASIC are built in. Atari's own
      operating systems, BASIC and peripheral ROMs can be imported, from ROM
      images or MAME's sets.
    </p>
    <p>
      The Atari's keyboard, console keys and joysticks are on screen when
      wanted, gamepads are picked up as they are plugged in and out, the mouse
      drives paddles, the Koala Pad, mice and the light pen, and a native
      debugger shows the 6502, disassembly with breakpoints and watchpoints,
      ANTIC and its display list, GTIA, POKEY, PIA, the memory map and every
      SIO command.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.atari800.gnome.desktop</launchable>
  <icon type="stock">online.fujinet.go.atari800.gnome</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <screenshots>
    <screenshot type="default">
      <caption>FujiNet's CONFIG on the Atari, browsing hosts and drive slots</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari800-desktop/v0.2.1/data/screenshots/1_running_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The debugger: disassembly with the OS's labels</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari800-desktop/v0.2.1/data/screenshots/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-atari800-desktop/v0.2.1/data/screenshots/3_preferences.png</image>
    </screenshot>
  </screenshots>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-atari800-desktop/issues</url>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-10-29">
      <description>
        <p>
          New: use an external FujiNet. A switch in Preferences skips the built-in FujiNet and listens on an address:port you enter (for example 0.0.0.0:11514), so another FujiNet instance can connect to it.
        </p>
      </description>
    </release>
    <release version="0.2.2" date="2026-10-27">
      <description>
        <p>
          The Flatpak bundles now name Flathub as their runtime repository, so a downloaded bundle can fetch the GNOME or KDE runtime on a machine that has not set up Flathub.
        </p>
      </description>
    </release>
    <release version="0.2.1" date="2026-10-27">
      <description>
        <p>
          The Flatpak builds on the GNOME 51 runtime. The software-centre
          listing now credits FujiNet as developer, declares the app icon,
          and shows a full set of screenshots for each frontend.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-19">
      <description>
        <p>
          Debugger: a FujiNet tab shows every SIO packet between the Atari
          and FujiNet over NetSIO, both ways, with hex.
        </p>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-18">
      <description>
        <p>
          On-screen keys hold for 3 frames, so a quick click is never lost.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-18">
      <description>
        <p>
          First release: atari800 with an in-process FujiNet over NetSIO,
          every 8-bit model, built-in AltirraOS, native GNOME, KDE, macOS and
          Windows frontends, the keyboard and joysticks on screen, hotplugged
          gamepads and a native debugger.
        </p>
      </description>
    </release>
  </releases>
</component>
